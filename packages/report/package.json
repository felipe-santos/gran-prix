{
  "name": "@gran-prix/report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gp report: renders an EvalReport (contract gran-prix.eval-report) as ONE self-contained, offline HTML document (inline CSS and SVG, no scripts, fonts or CDNs).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gp-report": "./bin/gp-report.mjs"
  },
  "files": [
    "dist",
    "bin",
    "examples"
  ],
  "scripts": {
    "build:deps": "pnpm --filter @gran-prix/contracts build",
    "build": "pnpm run build:deps && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run",
    "example": "pnpm run build && node scripts/build-example.mjs"
  },
  "dependencies": {
    "@gran-prix/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
