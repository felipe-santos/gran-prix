{
  "format": "gran-prix.pipeline-spec",
  "format_version": "1.0.0",
  "name": "fixture-dom-pipeline",
  "description": "Synthetic pipeline used by the contract fixtures.",
  "vars": {
    "seed": 42
  },
  "externals": {
    "urls": {
      "type": "UrlList",
      "path": "data/urls.csv"
    },
    "schema": {
      "type": "FeatureSchema",
      "id": "sha256:8d1aee97199968bcf69558ff925fd7538602b58098cf8edd9eaa4542674f722b"
    }
  },
  "stages": [
    {
      "id": "collect",
      "kind": "collect",
      "impl": "ts:collect.playwright@1.0.0",
      "params": {
        "viewport": [
          1366,
          900
        ],
        "wait": "networkidle+2s"
      },
      "inputs": {
        "urls": {
          "external": "urls"
        }
      }
    },
    {
      "id": "extract",
      "kind": "extract",
      "impl": "ts:extract.dom-node@1.0.0",
      "params": {},
      "inputs": {
        "snapshots": {
          "stage": "eval",
          "output": "report"
        },
        "schema": {
          "external": "schema"
        }
      }
    },
    {
      "id": "label",
      "kind": "label",
      "impl": "ts:label.heuristic@1.0.0",
      "params": {
        "confidence": 0.8
      },
      "inputs": {
        "snapshots": {
          "stage": "collect",
          "output": "snapshots"
        },
        "features": {
          "stage": "extract",
          "output": "features"
        }
      }
    },
    {
      "id": "dataset",
      "kind": "dataset",
      "impl": "ts:dataset.jsonl@1.0.0",
      "params": {
        "split": {
          "group_by": "group_key",
          "salt": "fixture-v1"
        },
        "min_confidence": 0.5
      },
      "inputs": {
        "features": {
          "stage": "extract",
          "output": "features"
        },
        "labels": {
          "stage": "label",
          "output": "labels"
        },
        "schema": {
          "external": "schema"
        }
      }
    },
    {
      "id": "train",
      "kind": "train",
      "impl": "ts:train.wasm-trainer@1.0.0",
      "params": {
        "seed": "${vars.seed}",
        "epochs": 30
      },
      "inputs": {
        "dataset": {
          "stage": "dataset",
          "output": "dataset"
        }
      }
    },
    {
      "id": "eval",
      "kind": "evaluate",
      "impl": "ts:evaluate.intrinsic@1.0.0",
      "params": {
        "split": "test",
        "baselines": [
          "readability"
        ]
      },
      "inputs": {
        "model": {
          "stage": "train",
          "output": "model"
        },
        "dataset": {
          "stage": "dataset",
          "output": "dataset"
        }
      },
      "gate": true
    }
  ],
  "layout": {
    "collect": {
      "x": 0,
      "y": 0
    },
    "extract": {
      "x": 200,
      "y": 0
    }
  }
}
