{
  "format": "gran-prix.train-config",
  "format_version": "1.0.0",
  "seed": 42,
  "network": {
    "kind": "def",
    "def": {
      "input_dim": 4,
      "layers": [
        {
          "type": "linear",
          "in_features": 4,
          "out_features": 3
        },
        {
          "type": "batchnorm",
          "num_features": 3
        },
        {
          "type": "linear",
          "in_features": 3,
          "out_features": 1
        }
      ]
    }
  },
  "loss": "bce_logits",
  "optimizer": {
    "kind": "adam",
    "lr": 0.01
  },
  "lr_schedule": {
    "kind": "cosine",
    "min_lr": 0.0001
  },
  "epochs": 30,
  "batch_size": 64,
  "data": {
    "min_confidence": 0.5,
    "allowed_sources": [
      "human",
      "llm",
      "heuristic"
    ],
    "class_balance": {
      "strategy": "none"
    }
  },
  "normalization": {
    "kind": "zscore",
    "fit_on": "train"
  },
  "early_stopping": {
    "metric": "val_loss",
    "patience": 5,
    "min_delta": 0.0001
  },
  "threshold": {
    "strategy": "max_f1_on_val"
  },
  "runtime": {
    "engine": "wasm-node"
  }
}
