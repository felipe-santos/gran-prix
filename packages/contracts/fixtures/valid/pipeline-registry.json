[
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "collect",
    "impl": "ts:collect.playwright@1.0.0",
    "inputs": [
      {
        "name": "urls",
        "type": "UrlList"
      }
    ],
    "outputs": [
      {
        "name": "snapshots",
        "type": "SnapshotSet"
      }
    ],
    "params_schema": {
      "type": "object",
      "required": [
        "viewport"
      ],
      "properties": {
        "viewport": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "wait": {
          "type": "string"
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1
        },
        "captured_at": {
          "type": "string"
        },
        "fail_on_error": {
          "type": "boolean"
        }
      }
    },
    "runtime": "node+playwright",
    "determinism": "external",
    "map_over": "group"
  },
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "extract",
    "impl": "ts:extract.dom-node@1.0.0",
    "inputs": [
      {
        "name": "snapshots",
        "type": "SnapshotSet"
      },
      {
        "name": "schema",
        "type": "FeatureSchema"
      }
    ],
    "outputs": [
      {
        "name": "features",
        "type": "NodeFeaturesSet"
      }
    ],
    "params_schema": {
      "type": "object",
      "additionalProperties": false
    },
    "runtime": "node",
    "determinism": "pure",
    "map_over": "group"
  },
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "label",
    "impl": "ts:label.heuristic@1.0.0",
    "inputs": [
      {
        "name": "snapshots",
        "type": "SnapshotSet"
      },
      {
        "name": "features",
        "type": "NodeFeaturesSet"
      }
    ],
    "outputs": [
      {
        "name": "labels",
        "type": "NodeLabelsSet"
      }
    ],
    "params_schema": {
      "type": "object",
      "properties": {
        "labeler": {
          "enum": [
            "readability"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "runtime": "node",
    "determinism": "pure",
    "map_over": "group"
  },
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "dataset",
    "impl": "ts:dataset.jsonl@1.0.0",
    "inputs": [
      {
        "name": "features",
        "type": "NodeFeaturesSet"
      },
      {
        "name": "labels",
        "type": "NodeLabelsSet"
      },
      {
        "name": "schema",
        "type": "FeatureSchema"
      },
      {
        "name": "snapshots",
        "type": "SnapshotSet",
        "optional": true
      }
    ],
    "outputs": [
      {
        "name": "dataset",
        "type": "Dataset"
      }
    ],
    "params_schema": {
      "type": "object",
      "required": [
        "split"
      ],
      "properties": {
        "split": {
          "type": "object",
          "required": [
            "seed"
          ],
          "properties": {
            "seed": {
              "type": [
                "string",
                "integer"
              ]
            },
            "ranges": {
              "type": "object"
            },
            "overrides": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "train",
                  "val",
                  "test"
                ]
              }
            },
            "group_by": {
              "enum": [
                "group_key",
                "group"
              ]
            }
          },
          "additionalProperties": false
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "runtime": "node",
    "determinism": "pure"
  },
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "train",
    "impl": "rust:train.gp-train@1.0.0",
    "inputs": [
      {
        "name": "dataset",
        "type": "Dataset"
      },
      {
        "name": "config",
        "type": "TrainConfig",
        "optional": true
      }
    ],
    "outputs": [
      {
        "name": "model",
        "type": "ModelPackage"
      }
    ],
    "params_schema": {
      "type": "object",
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "config": {
          "type": "object"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "task_name": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": "rust",
    "determinism": "seeded"
  },
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "evaluate",
    "impl": "ts:evaluate.intrinsic@1.0.0",
    "inputs": [
      {
        "name": "model",
        "type": "ModelPackage"
      },
      {
        "name": "dataset",
        "type": "Dataset"
      },
      {
        "name": "baselines",
        "type": "Bundle",
        "many": true,
        "optional": true
      },
      {
        "name": "label_baselines",
        "type": "NodeLabelsSet",
        "many": true,
        "optional": true
      }
    ],
    "outputs": [
      {
        "name": "report",
        "type": "EvalReport"
      },
      {
        "name": "extras",
        "type": "Bundle"
      },
      {
        "name": "details",
        "type": "Bundle"
      }
    ],
    "params_schema": {
      "type": "object",
      "required": [
        "seed"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test",
            "all"
          ]
        },
        "resamples": {
          "type": "integer",
          "minimum": 100
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "runtime": "node+wasm",
    "determinism": "seeded",
    "gates": [
      {
        "id": "params_gates",
        "description": "Every entry of params.gates (metric, comparator, threshold, strata, baseline, CI bound) becomes a gates[] entry of the report."
      }
    ]
  },
  {
    "format": "gran-prix.stage-kind-spec",
    "format_version": "1.0.0",
    "kind": "package",
    "impl": "ts:package.bundle@1.0.0",
    "inputs": [
      {
        "name": "model",
        "type": "ModelPackage"
      }
    ],
    "outputs": [
      {
        "name": "bundle",
        "type": "Bundle"
      }
    ],
    "params_schema": {
      "type": "object",
      "additionalProperties": false
    },
    "runtime": "node+wasm",
    "determinism": "pure"
  }
]
