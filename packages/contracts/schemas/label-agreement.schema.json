{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gran-prix:schema:label-agreement",
  "x-gran-prix": {
    "contract": "label-agreement",
    "format": "gran-prix.label-agreement",
    "version": "1.0.0"
  },
  "$defs": {
    "Ci95": {
      "description": "[lo, hi], lo <= hi.",
      "type": "array",
      "items": [
        { "type": "number" },
        { "type": "number" }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2
    },
    "Gate": {
      "type": "object",
      "required": ["id", "rule", "value", "passed"],
      "properties": {
        "id": { "minLength": 1, "type": "string" },
        "rule": {
          "description": "Human-readable rule, e.g. 'F1(MLP) - F1(best single) >= 0.05 and CI lower bound > 0'.",
          "type": "string"
        },
        "value": {
          "description": "The number compared with `threshold`: the point estimate, or the CI bound when `use_ci_lower` is true.",
          "type": "number"
        },
        "passed": { "type": "boolean" },
        "name": {
          "description": "Display name, e.g. 'G1a F1 gain on hard strata'.",
          "type": "string"
        },
        "comparator": {
          "description": "`value <comparator> threshold` is the passing condition.",
          "anyOf": [
            { "const": ">=", "type": "string" },
            { "const": ">", "type": "string" },
            { "const": "<=", "type": "string" },
            { "const": "<", "type": "string" },
            { "const": "==", "type": "string" }
          ]
        },
        "threshold": { "type": "number" },
        "unit": {
          "description": "Unit of value / threshold / observed: 'f1', 'pp', 'ratio', 'x', 'ms', 'bytes', 'kappa', ...",
          "type": "string"
        },
        "stratum": {
          "description": "Stratum or aggregate name the gate is evaluated on (e.g. 'hard'); absent = overall.",
          "type": "string"
        },
        "observed": {
          "description": "Point estimate in `unit` (the number the reader sees).",
          "type": "number"
        },
        "ci95": { "$ref": "#/$defs/Ci95" },
        "use_ci_lower": {
          "description": "true: the gate is decided on the CI bound facing the threshold (ci95[0] for >= and >, ci95[1] for <= and <), and `value` equals that bound.",
          "type": "boolean"
        }
      }
    },
    "Iso8601": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 / ISO 8601 date-time. Provenance only.",
      "type": "string"
    },
    "Provenance": {
      "description": "Where an artifact came from. Outside every content id.",
      "type": "object",
      "required": ["produced_by", "inputs", "pipeline_spec_id", "tool_versions", "created_at", "duration_ms"],
      "properties": {
        "produced_by": {
          "type": "object",
          "required": ["run_id", "stage_id", "kind", "impl", "params_sha256", "cache_key"],
          "properties": {
            "run_id": { "minLength": 1, "type": "string" },
            "stage_id": { "minLength": 1, "type": "string" },
            "kind": { "minLength": 1, "type": "string" },
            "impl": { "minLength": 1, "type": "string" },
            "params_sha256": { "$ref": "#/$defs/Sha256" },
            "cache_key": { "$ref": "#/$defs/Sha256" }
          }
        },
        "inputs": {
          "description": "Edges of the lineage DAG.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["port", "artifact_id"],
            "properties": {
              "port": { "type": "string" },
              "artifact_id": { "$ref": "#/$defs/Sha256" }
            }
          }
        },
        "pipeline_spec_id": { "$ref": "#/$defs/Sha256" },
        "tool_versions": {
          "type": "object",
          "required": ["gp_cli", "node"],
          "properties": {
            "gp_cli": { "type": "string" },
            "git_commit": { "type": "string" },
            "git_dirty": { "type": "boolean" },
            "node": { "type": "string" },
            "wasm_sha256": { "$ref": "#/$defs/Sha256" },
            "tool_sha256": { "$ref": "#/$defs/Sha256" },
            "extractor": {
              "type": "object",
              "required": ["name", "version", "bundle_sha256"],
              "properties": {
                "name": { "type": "string" },
                "version": { "$ref": "#/$defs/SemVer" },
                "bundle_sha256": { "$ref": "#/$defs/Sha256" }
              }
            }
          }
        },
        "created_at": { "$ref": "#/$defs/Iso8601" },
        "host": { "type": "string" },
        "duration_ms": { "minimum": 0, "type": "integer" }
      }
    },
    "SemVer": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semantic version x.y.z.",
      "type": "string"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Content id: sha256: + 64 lowercase hex characters.",
      "type": "string"
    }
  },
  "title": "label-agreement",
  "description": "Cohen's kappa audit between labelers on the audited pages: per pair and stratum, binary and 3-class, element- and char-weighted, with group-bootstrap CIs and the gates it feeds.",
  "type": "object",
  "required": ["format", "format_version", "agreement_id", "population", "labelers", "pairs", "provenance"],
  "properties": {
    "format": { "const": "gran-prix.label-agreement", "type": "string" },
    "format_version": { "$ref": "#/$defs/SemVer" },
    "agreement_id": { "$ref": "#/$defs/Sha256" },
    "dataset_id": { "$ref": "#/$defs/Sha256" },
    "guide_version": {
      "description": "Version of the labeling guide the labelers followed.",
      "type": "string"
    },
    "population": {
      "type": "object",
      "required": ["unit", "n_groups", "n_units", "by_stratum"],
      "properties": {
        "unit": {
          "minLength": 1,
          "description": "e.g. dom-element-with-own-text (the universe U).",
          "type": "string"
        },
        "n_groups": { "minimum": 1, "type": "integer" },
        "n_units": { "minimum": 1, "type": "integer" },
        "n_chars": { "minimum": 0, "type": "integer" },
        "by_stratum": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "object",
              "required": ["n_groups", "n_units"],
              "properties": {
                "n_groups": { "minimum": 0, "type": "integer" },
                "n_units": { "minimum": 0, "type": "integer" }
              }
            }
          }
        }
      }
    },
    "labelers": {
      "minProperties": 2,
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "anyOf": [
                    { "const": "rule", "type": "string" },
                    { "const": "heuristic", "type": "string" },
                    { "const": "readability", "type": "string" },
                    { "const": "llm", "type": "string" },
                    { "const": "human", "type": "string" },
                    { "const": "user_feedback", "type": "string" }
                  ]
                },
                { "const": "merge", "type": "string" }
              ]
            },
            "version": { "type": "string" },
            "labels_ids": {
              "description": "NodeLabels documents this labeler contributed to the audit.",
              "type": "array",
              "items": { "$ref": "#/$defs/Sha256" }
            }
          }
        }
      }
    },
    "pairs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "stratum", "results"],
        "properties": {
          "a": {
            "minLength": 1,
            "description": "Key of `labelers`.",
            "type": "string"
          },
          "b": {
            "minLength": 1,
            "description": "Key of `labelers`.",
            "type": "string"
          },
          "stratum": {
            "minLength": 1,
            "description": "'overall' (pooled) or a stratum / aggregate name.",
            "type": "string"
          },
          "results": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "required": ["space", "weighting", "classes", "confusion", "n", "observed_agreement", "expected_agreement", "kappa", "n_groups"],
              "properties": {
                "space": {
                  "description": "binary = keep (main + support) vs drop (the one that trains); three_class = main / support / noise.",
                  "anyOf": [
                    { "const": "binary", "type": "string" },
                    { "const": "three_class", "type": "string" }
                  ]
                },
                "weighting": {
                  "anyOf": [
                    { "const": "elements", "type": "string" },
                    { "const": "chars", "type": "string" }
                  ]
                },
                "classes": {
                  "minItems": 2,
                  "type": "array",
                  "items": { "minLength": 1, "type": "string" }
                },
                "confusion": {
                  "description": "Square, classes.length x classes.length.",
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": { "minimum": 0, "type": "integer" }
                  }
                },
                "n": { "minimum": 0, "type": "integer" },
                "observed_agreement": { "minimum": 0, "maximum": 1, "type": "number" },
                "expected_agreement": { "minimum": 0, "maximum": 1, "type": "number" },
                "kappa": { "minimum": -1, "maximum": 1, "type": "number" },
                "ci95": { "$ref": "#/$defs/Ci95" },
                "n_groups": { "minimum": 0, "type": "integer" }
              }
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["resamples", "seed", "cluster_by", "method", "stratified"],
      "properties": {
        "resamples": { "minimum": 1, "type": "integer" },
        "seed": { "minimum": 0, "type": "integer" },
        "cluster_by": {
          "description": "What is resampled: group_key (registrable domain, default of the protocol) or group_id (a page).",
          "anyOf": [
            { "const": "group_key", "type": "string" },
            { "const": "group_id", "type": "string" }
          ]
        },
        "method": { "const": "percentile", "type": "string" },
        "stratified": {
          "description": "true: resampling is done inside each stratum.",
          "type": "boolean"
        }
      }
    },
    "retest": {
      "description": "Test-retest of one human against their own earlier labels (blind), protocol 5.4.",
      "type": "object",
      "required": ["labeler", "n_groups", "n_units", "interval_days", "kappa_binary"],
      "properties": {
        "labeler": { "minLength": 1, "type": "string" },
        "n_groups": { "minimum": 1, "type": "integer" },
        "n_units": { "minimum": 1, "type": "integer" },
        "interval_days": { "minimum": 0, "type": "integer" },
        "kappa_binary": { "minimum": -1, "maximum": 1, "type": "number" },
        "ci95": { "$ref": "#/$defs/Ci95" }
      }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/Gate" }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "anyOf": [
              { "const": "note", "type": "string" },
              { "const": "threat", "type": "string" }
            ]
          },
          "text": { "minLength": 1, "type": "string" }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/Provenance" }
  }
}
