{
  "name": "@gran-prix/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gran-Prix Studio: local, keyboard-first human label review UI (3 classes + doubt/mixed flags) over the SnapshotSets of a gp data dir. Binds to 127.0.0.1 only; nothing leaves the machine.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "gp-studio": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:ui": "vite build",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit"
  },
  "dependencies": {
    "@gran-prix/contracts": "workspace:*",
    "@gran-prix/labels": "workspace:*"
  },
  "devDependencies": {
    "@gran-prix/cli": "workspace:*",
    "@gran-prix/features": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "playwright-core": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
