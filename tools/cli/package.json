{
  "name": "@gran-prix/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gp: runs PipelineSpec files incrementally over a content-addressed artifact store, with receipts, lineage and a budget ledger; checks ModelPackages.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gp": "node dist/bin.js"
  },
  "dependencies": {
    "@gran-prix/contracts": "workspace:*",
    "@gran-prix/features": "workspace:*",
    "@gran-prix/infer-ts": "workspace:*",
    "@gran-prix/labels": "workspace:*",
    "@gran-prix/markdown": "workspace:*",
    "@gran-prix/model": "workspace:*",
    "@gran-prix/report": "workspace:*",
    "@gran-prix/stats": "workspace:*",
    "defuddle": "0.19.13",
    "tldts": "~7.5.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
